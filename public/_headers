/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://unpkg.com; style-src 'self' https://unpkg.com; img-src 'self' data: https://unpkg.com https://tile.openstreetmap.org; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=()

/app.js
  Cache-Control: public, max-age=3600, must-revalidate

/theme.js
  Cache-Control: public, max-age=3600, must-revalidate

/ebs.js
  Cache-Control: public, max-age=3600, must-revalidate

/event-workflow.js
  Cache-Control: public, max-age=3600, must-revalidate

/cadre-quality.js
  Cache-Control: public, max-age=3600, must-revalidate

/cadre-statistics.js
  Cache-Control: public, max-age=3600, must-revalidate

/cadre-profile.js
  Cache-Control: public, max-age=3600, must-revalidate

/styles.css
  Cache-Control: public, max-age=3600, must-revalidate

/assets/*
  Cache-Control: public, max-age=86400, must-revalidate

/brand.js
  Cache-Control: no-cache

/branding.js
  Cache-Control: no-cache

/branding.css
  Cache-Control: no-cache

/project.js
  Cache-Control: no-cache

/LICENSE.txt
  Cache-Control: no-cache
